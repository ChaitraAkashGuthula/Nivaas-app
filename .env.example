# =====================================================
# NIVAAS — Environment Variable Reference
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =====================================================


# ── Server ────────────────────────────────────────
# Port the Express server listens on (default: 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Comma-separated list of allowed CORS origins in production
# Example: https://nivaas.com,https://www.nivaas.com
# Leave empty in development (all origins allowed)
ALLOWED_ORIGINS=


# ── Database ──────────────────────────────────────
# MySQL connection string  (mysql2 / drizzle-orm)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=


# ── Authentication / Session ──────────────────────
# Secret used to sign JWT session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# OAuth server base URL (provided by the Manus identity platform)
OAUTH_SERVER_URL=

# OpenID of the application owner / admin user
OWNER_OPEN_ID=


# ── Storage (S3-compatible via Manus Forge) ────────
# Internal Forge API endpoint for image/file storage
BUILT_IN_FORGE_API_URL=

# API key for the Forge storage/image-generation service
BUILT_IN_FORGE_API_KEY=


# ── Application ───────────────────────────────────
# Public application ID (used in OAuth flows)
VITE_APP_ID=


# ── Analytics (Optional) ──────────────────────────
# Umami analytics endpoint — leave empty to disable
VITE_ANALYTICS_ENDPOINT=

# Umami analytics website ID — leave empty to disable
VITE_ANALYTICS_WEBSITE_ID=
